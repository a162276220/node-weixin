{
  "name": "node-weixin",
  "version": "2.0.0",
  "private": true,
  "description": "nodejs + socket.io 多人在线聊天后台系统（现代化版本）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "init:counters": "node scripts/init-counters.js",
    "pm2:start": "pm2 start index.js --name node-weixin",
    "pm2:stop": "pm2 stop node-weixin",
    "pm2:restart": "pm2 restart node-weixin"
  },
  "keywords": [
    "node",
    "vue",
    "socket.io",
    "chat"
  ],
  "license": "MIT",
  "dependencies": {
    "connect-history-api-fallback": "^2.0.0",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.12.1",
    "socket.io": "^4.8.4"
  }
}
