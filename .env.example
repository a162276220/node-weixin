# 运行端口
PORT=8003
NODE_ENV=development

# MongoDB 连接串
MONGO_URI=mongodb://127.0.0.1:27017/weixin

# session 加密密钥：生产环境必填（未设置会直接启动失败）
SESSION_SECRET=please-change-me-to-a-long-random-string
SESSION_MAX_AGE=604800000

# 允许跨域的前端来源，逗号分隔；开发环境留空表示放行全部
# CORS_ORIGINS=http://localhost:8080,https://chat.example.com

# 第三方问答接口（原代码里硬编码的 APPCODE）
# ROBOT_ENDPOINT=http://jisuznwd.market.alicloudapi.com/iqa/query
# ROBOT_APPCODE=your-appcode
